<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="circle">
        <item name="cornerSize">50%</item>
    </style>

    <style name="rectangle_cornered">
        <item name="cornerSize">25%</item>
    </style>

    <style name="rectangled_cornering">
        <item name="cornerSize">10%</item>
    </style>

    <style name="CustomBottomSheetDialogTheme" parent="Theme.Design.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="MenuTextStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">@dimen/_14sdp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingVertical">@dimen/_8sdp</item>
        <item name="android:paddingHorizontal">@dimen/_3sdp</item>
        <item name="android:layout_marginBottom">@dimen/_5sdp</item>
    </style>

    <style name="MenuDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginHorizontal">@dimen/_3sdp</item>
        <item name="android:layout_marginVertical">@dimen/_2sdp</item>
        <item name="android:background">@color/accent6</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="BottomSheetDivider" parent="MenuDivider">
        <item name="android:background">@color/primary2</item>
    </style>
</resources>
